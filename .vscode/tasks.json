{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build active C++ file",
            "type": "shell",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compile the active C++ file into ./build."
        },
        {
            "label": "Run active C++ file",
            "type": "shell",
            "dependsOn": "Build active C++ file",
            "command": "${workspaceFolder}/build/${fileBasenameNoExtension}",
            "group": "test",
            "problemMatcher": [],
            "detail": "Build and run the active C++ file."
        }
    ]
}
